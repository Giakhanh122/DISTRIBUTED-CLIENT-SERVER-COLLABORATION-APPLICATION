<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<VBox stylesheets="@../css/dl-chat-theme.css"
      styleClass="window-root"
      prefWidth="1080.0" prefHeight="700.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ui.controller.ChatController">

    <!-- Custom Flat Title Bar -->
    <HBox fx:id="titleBar" styleClass="title-bar" alignment="CENTER_LEFT" spacing="8.0">
        <padding>
            <Insets left="14.0" right="0.0" top="0.0" bottom="0.0"/>
        </padding>
        <ImageView fitWidth="18.0" fitHeight="18.0" preserveRatio="true">
            <image>
                <Image url="@../assets/DL-Chat-icon-32.png"/>
            </image>
        </ImageView>
        <Label fx:id="titleBarLabel" text="DL-Chat" styleClass="title-bar-text"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="minimizeBtn" text="-" styleClass="window-btn" onAction="#handleMinimize"/>
        <Button fx:id="maximizeBtn" text="☐" styleClass="window-btn" onAction="#handleMaximize"/>
        <Button fx:id="closeBtn" text="✕" styleClass="window-btn-close" onAction="#handleClose"/>
    </HBox>

    <!-- Main Content Layout -->
    <HBox VBox.vgrow="ALWAYS" spacing="0">

        <!-- Guild Rail (Primary App Navigation) -->
        <VBox prefWidth="56.0" minWidth="56.0" maxWidth="56.0" styleClass="guild-rail" alignment="TOP_CENTER" spacing="10.0">
            <padding>
                <Insets top="12.0" bottom="12.0" left="0.0" right="0.0"/>
            </padding>

            <Button fx:id="homeBtn" onAction="#handleSelectCommunitiesTab" style="-fx-background-color: transparent; -fx-padding: 0; -fx-cursor: hand;">
                <graphic>
                    <ImageView fitWidth="36.0" fitHeight="36.0" preserveRatio="true">
                        <image>
                            <Image url="@../assets/DL-Chat-icon-48.png"/>
                        </image>
                    </ImageView>
                </graphic>
            </Button>

            <Region prefHeight="1.0" maxWidth="26.0" style="-fx-background-color: #27272A;"/>

            <Button fx:id="railCommunitiesBtn" onAction="#handleSelectCommunitiesTab" styleClass="rail-btn-active"/>
            <Button fx:id="railExploreBtn" onAction="#handleSelectExploreTab" styleClass="rail-btn"/>
            <Button fx:id="railDirectBtn" onAction="#handleSelectDirectTab" styleClass="rail-btn"/>

            <Region prefHeight="1.0" maxWidth="26.0" style="-fx-background-color: #27272A;"/>

            <Button fx:id="addCommunityBtn" onAction="#handleOpenCreateCommunityDialog" text="+" styleClass="rail-btn-add"/>
        </VBox>

        <!-- Sidebar: Communities & Users List -->
        <VBox prefWidth="260.0" minWidth="240.0" maxWidth="300.0" styleClass="channel-sidebar">

            <VBox spacing="10.0" style="-fx-padding: 14px 12px 10px 12px;">
                <TextField fx:id="searchField" promptText="Search communities..." styleClass="search-input"/>
                <Label fx:id="sidebarSectionTitle" text="COMMUNITIES" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #71717A; -fx-padding: 2px 2px 0 2px;"/>
            </VBox>

            <StackPane VBox.vgrow="ALWAYS">
                <ListView fx:id="communitiesListView" styleClass="list-view"/>
                <ListView fx:id="usersListView" styleClass="list-view" visible="false" managed="false"/>
            </StackPane>

            <!-- Current User Info -->
            <HBox alignment="CENTER_LEFT" spacing="10.0"
                  style="-fx-background-color: #FFFFFF; -fx-padding: 10px 14px; -fx-border-color: #E4E4E7; -fx-border-width: 1 0 0 0;">
                <StackPane fx:id="currentUserAvatar" prefWidth="32.0" prefHeight="32.0" styleClass="avatar-circle">
                    <Label fx:id="currentUserInitials" text="ME" styleClass="avatar-text"/>
                </StackPane>
                <VBox alignment="CENTER_LEFT" spacing="1.0" HBox.hgrow="ALWAYS">
                    <Label fx:id="currentUsernameLabel" text="Username" style="-fx-font-weight: bold; -fx-text-fill: #18181B; -fx-font-size: 13px;"/>
                    <HBox alignment="CENTER_LEFT" spacing="4.0">
                        <Circle fx:id="connectionStatusDot" radius="3.5" styleClass="status-dot-online"/>
                        <Label fx:id="connectionStatusLabel" text="Online" wrapText="true" maxWidth="170.0" style="-fx-font-size: 10px; -fx-text-fill: #10B981;"/>
                    </HBox>
                    <Button fx:id="reconnectBtn" text="Kết nối lại" onAction="#handleReconnect"
                            styleClass="btn-secondary" visible="false" managed="false"/>
                </VBox>
                <Button fx:id="logoutBtn" onAction="#handleLogout" styleClass="btn-icon"/>
            </HBox>

        </VBox>

        <!-- Main Chat Panel -->
        <VBox HBox.hgrow="ALWAYS" styleClass="chat-panel">

            <HBox fx:id="chatHeader" alignment="CENTER_LEFT" spacing="12.0" prefHeight="56.0" styleClass="chat-header">
                <padding>
                    <Insets left="16.0" right="16.0" top="8.0" bottom="8.0"/>
                </padding>

                <StackPane fx:id="targetAvatar" prefWidth="36.0" prefHeight="36.0" styleClass="avatar-circle">
                    <Label fx:id="targetInitials" text="#" styleClass="avatar-text"/>
                </StackPane>

                <VBox alignment="CENTER_LEFT" spacing="2.0">
                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <Label fx:id="targetNameLabel" text="Select a conversation" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #09090B;"/>
                        <Circle fx:id="targetStatusDot" radius="4.0" styleClass="status-dot-offline" visible="false"/>
                    </HBox>
                    <Label fx:id="targetMetaLabel" text="No active conversation" style="-fx-font-size: 12px; -fx-text-fill: #71717A;"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <HBox alignment="CENTER_RIGHT" spacing="8.0">
                    <Button fx:id="joinLeaveCommunityBtn" text="Join Community" onAction="#handleToggleJoinCommunity" styleClass="btn-primary" visible="false" managed="false"/>
                </HBox>
            </HBox>

            <StackPane VBox.vgrow="ALWAYS">
                <VBox fx:id="emptyStateView" alignment="CENTER" spacing="10.0" style="-fx-padding: 30px;">
                    <StackPane fx:id="emptyStateIconContainer" prefWidth="48.0" prefHeight="48.0"/>
                    <Label text="DL-Chat" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #09090B;"/>
                    <Label text="Select a Community or an Online User to begin chatting."
                           style="-fx-font-size: 13px; -fx-text-fill: #71717A; -fx-text-alignment: center;" wrapText="true" maxWidth="380.0"/>
                </VBox>

                <ScrollPane fx:id="messageScrollPane" fitToWidth="true" styleClass="scroll-pane" visible="false" managed="false">
                    <VBox fx:id="messagesContainer" spacing="10.0">
                        <padding>
                            <Insets top="14.0" right="18.0" bottom="14.0" left="18.0"/>
                        </padding>
                    </VBox>
                </ScrollPane>
            </StackPane>

            <!-- Input Area -->
            <HBox fx:id="inputContainer" alignment="CENTER_LEFT" spacing="8.0" styleClass="chat-input-area" disable="true">
                <padding>
                    <Insets top="8.0" right="16.0" bottom="10.0" left="16.0"/>
                </padding>
                <Button fx:id="attachBtn" onAction="#handleAttachFile" styleClass="btn-icon"/>
                <TextField fx:id="messageInput" promptText="Write a message..." HBox.hgrow="ALWAYS"
                           styleClass="text-input" onAction="#handleSendMessage"/>
                <Button fx:id="sendBtn" onAction="#handleSendMessage" styleClass="btn-primary" style="-fx-padding: 8px 12px;"/>
            </HBox>

        </VBox>

    </HBox>

</VBox>
